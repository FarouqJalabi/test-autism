<!--hidden  invisible -->
<div class="card bg-white w-full absolute question duration-500 delay-100"
     style="<%= question.order != 1 ? 'visibility: hidden; transform: translateX(100vw);' : '' %> "
     data-controller="questions"
     data-order="<%= question.order %>" data-test="<%= question.test.id %>" data-total="<%= question_length(question) %>" >

    <div class="card-body flex items-center justify-center md:gap-16">
    <h1 class="card-title w-full h-32 text-2xl md:text-4xl lg:text-5xl flex items-center justify-center"><%= question.content %></h1>

    <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-start sm:items-start justify-center">
      <%- values = @test.choices.pluck(:value) %>
      <%- values.reverse! if question.negative_key? %>

      <% @test.choices.each_with_index  do |choice, index| %>
        <div class="flex items-center gap-4 sm:flex-col-reverse">
          <%= form.radio_button(question.id, values[index], id:"question_#{question.id }_radio_#{index}", autocomplete: "off", class:"radio radio-primary radio-lg", "data-controller":"radio",  "data-action":"click->questions#radio_clicked change->questions#save_change") %>
          <label class="md:text-2xl lg:text-3xl" for="question_<%= question.id %>_radio_<%= index %>">
            <%= choice.label %>
          </label>

        </div>
      <% end %>
    </div>

    <div class="card-actions h-12 w-full">
      <% if question.order != 1 %>
        <button type="button" data-action="click->questions#back_clicked" class="w-12 sm:w-16 m-auto">
          <%= image_tag "Arrow.svg", alt: t("questions.backButton"), class: "arrow_icon"%>
        </button>
      <% end %>

      <% if question.order == question_length(question) %>
        <%= form.submit t("questions.submit"), class: "btn btn-primary hidden m-auto", onclick: "" %>
      <% end %>
    </div>
  </div>
</div> 
