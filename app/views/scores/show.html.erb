<section class="max-w-80 md:max-w-[50rem] m-auto grid gap-10 md:px-24 lg:px-12 print:hidden">
  <h1 class="text-3xl font-bold md:text-5xl mb-8"><%= percentage_to_header(@score.score_percent) %></h1>

  <div class="relative">
    <div class="absolute result-progress-percentage" style="left: <%= @score.score_percent%>%;">
      <span class="whitespace-nowrap md:text-lg font-light">
        <%= percentage_to_label(@score.score_percent) %>
      </span>
    </div>
    <progress class="progress progress-primary w-full" value="<%= @score.score_percent %>" max="100"></progress>
  </div>

  <div
    data-controller="share"
    data-label="<%= percentage_to_share(@score.score_percent) %>"
    data-language="<%= I18n.locale %>"
  >
    <p class="text-xl md:text-2xl"><%= percentage_to_description(@score.score_percent) %></p>

    <%= render "scores/share_buttons", score: @score %>
  </div>
</section>

<%= render 'answers_to_print' %>
