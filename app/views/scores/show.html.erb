<section class="max-w-80 md:max-w-[50rem] m-auto grid md:px-24 lg:px-12 print:hidden">
  <%= render @score.score_explanation, score_percent: @score.score_percent %>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-4">
      <% @score.category_scores&.each do |category_id, score| %>
        <%- category = @score.test.categories.find_by(id: category_id) %>
        <%- break unless category %>
        <%= render category, score: score %>
      <% end %>
    </div>

  <%= render "scores/share_buttons", score: @score %>

  
  <%- if @other_tests.any? %>
    <h2 class="text-2xl font-bold mt-5 "><%= t(".other_tests")%></h2>
    <div class="mt-2 flex flex-wrap gap-5 justify-center">
      <%= render @other_tests %>
    </div>
  <% end %>
</section>

<%= render 'answers_to_print' %>
