
<dialog id="disclaimer_modal" class="modal">
  <div class="modal-box">
    <h3 class="text-2xl font-bold"><%= t("aboutUs.disclaimer.title") %></h3>
    <p class="py-4"><%= t("aboutUs.disclaimer.description1") %></p>
    <p class="py-4"><%= t("aboutUs.disclaimer.description2") %></p>

    <div class="modal-action">
      <form method="dialog">
        <button class="btn">Close</button>
      </form>
    </div>

  </div>
</dialog>

<script>
 // It pop up on the start
 disclaimer_modal.showModal()
</script>


<% content_for :title, [@test.name, t('header.title')].join(" ")%>
<main class="grid px-3 gap-2 md:gap-20 sm:px-20 lg:px-40 overflow-hidden">
  <progress class="progress progress-primary w-full" value="0" max="100"></progress>

  <%= form_with model: @score do |form| %>
    <%= invisible_captcha %>
    <%= hidden_field_tag "test_id", params[:test_id].to_s || Test.first.id.to_s %>
    <div class="relative h-[35rem] w-full flex items-center justify-center">
      <%= render @test.questions, form: form %>
    </div>
  <% end %>
</main>
