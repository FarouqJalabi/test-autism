<% content_for :title, "Tests" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Tests</h1>
    <%= link_to "New test", new_test_path, class: "btn btn-primary" %>

  </div>

  <div id="tests" class="flex flex-wrap justify-center gap-5 min-w-full">
    <% if @tests.any? %>
      <% @tests.each do |test| %>
        <div>
          <%= render test %>

          <div class="flex w-full gap-2">
            <%= link_to "Show this test", test, class: "btn btn-outline flex-1" %>
            <%= link_to "Edit", [:edit, test], class: "btn btn-outline flex-1" %>
            <%= button_to "Destroy", test, method: :delete, class: "btn btn-error flex-1", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No tests found.</p>
    <% end %>
  </div>
</div>



<div class="card bg-base-100 border shadow-md p-4 w-96 mt-10 mx-5">
  <div class="flex justify-between items-center mb-2">
    <span class="font-semibold capitalize">Auto translations usage</span>
    <span class="text-sm opacity-70"><%= DeepL.usage.character_count %> / <%= DeepL.usage.character_limit %></span>
  </div>

  <progress class="progress progress-primary w-full mb-4" value="<%= DeepL.usage.character_count %>" max="<%= DeepL.usage.character_limit %>"></progress>
  <p>Auto translates missing translations to other languages.</p>
  <p class="mt-2">Translated outdated translations</p>
  <%= button_to "Translate", run_auto_translate_path, method: :post, class: "btn btn-primary mt-2 w-full" %>
</div>



